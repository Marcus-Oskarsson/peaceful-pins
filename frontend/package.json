{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check-types": "npx tsc --noemit",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0; npm run check-types",
    "lint:fix": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" && stylelint \"src/**/*.{css,scss}\" --fix",
    "preview": "vite preview --port 5173",
    "test": "npx cypress run",
    "test:watch": "npx cypress run --headless --component; npx cypress run --headless --e2e",
    "cy:open-e2e": "cypress open --e2e --browser chrome",
    "cy:open-unit": "cypress open --component --browser chrome",
    "cy:run-e2e": "cypress run --e2e",
    "cy:run-unit": "cypress run --component",
    "cy:e2e": "start-server-and-test dev http-get://localhost:3000 cy:open-e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.13.1",
    "formik": "^2.4.6",
    "hamburger-react": "^2.5.2",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.4",
    "react-toastify": "^11.0.5",
    "usehooks-ts": "^3.1.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^23.2.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.7",
    "@cypress/code-coverage": "^3.14.7",
    "@cypress/react": "^9.0.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/cypress": "^1.1.6",
    "@types/leaflet": "^1.9.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.1.0",
    "cypress": "^15.5.0",
    "eslint": "^9.38.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "mocha": "^11.7.4",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "start-server-and-test": "^2.1.2",
    "stylelint": "^16.25.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-order": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-istanbul": "^7.2.0",
    "vite-plugin-mkcert": "^1.17.9"
  }
}
